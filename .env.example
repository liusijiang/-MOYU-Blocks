# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MemFireDB (PostgreSQL / Supabase compatible) Public Client Configuration
# WARNING: Only expose the URL and ANON (public) key to client builds (Vercel / Vite).
# NEVER add FIRE_DB_SERV (Service Role / Admin Key) to client environment variables!
FIRE_DB_URL="https://d4v5cc8g91htqli3veng.baseapi.memfiredb.com"
FIRE_DB_ANON=""
# Or with VITE_ prefix for standard Vite / Vercel setups:
# VITE_FIRE_DB_URL="https://d4v5cc8g91htqli3veng.baseapi.memfiredb.com"
# VITE_FIRE_DB_ANON=""
